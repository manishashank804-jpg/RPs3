* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.game-container {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    text-align: center;
    width: 400px;
}

h1 {
    margin-bottom: 20px;
    font-size: 1.8rem;
}

.score-board {
    display: flex;
    justify-content: space-around;
    margin-bottom: 30px;
    background: rgba(0, 0, 0, 0.2);
    padding: 15px;
    border-radius: 10px;
}

.score span {
    font-size: 2.5rem;
    font-weight: bold;
}

.score p {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
}

.result-display {
    margin-bottom: 30px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
}

#game-message {
    font-size: 1.2rem;
    font-weight: 500;
}

.choices {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
}

.choice-btn {
    background: #ffffff;
    border: none;
    color: #333333;
    padding: 15px;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 15px;
    cursor: pointer;
    width: 100px;
    transition: transform 0.2s, background-color 0.2s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.choice-btn:hover {
    background: #e0e0e0;
    transform: translateY(-5px);
}

.choice-btn:active {
    transform: translateY(0);
}

.reset-btn {
    background: #ff4757;
    border: none;
    color: white;
    padding: 10px 20px;
    font-size: 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
}

.reset-btn:hover {
    background: #ff6b81;
}
